	}
}
*/
function bt_mouse_click(e)
{
	e.className = "tdbt_click";
}

function bt_mouse_over(e)
{
	e.className = "tdbt_over";
}

function bt_mouse_out(e)
{
	e.className = "tdbt_out";
}
function init()
{
	document.forms[0].username.disabled = false;
	document.forms[0].password.disabled = false;
	document.getElementById("html_title").text = login_title;
	var pathname_arr = window.location.toString().split('?');
	//initSize();
//	if (sys_target) {
		//var sys_target.toUpperCase();
	$('.loagin_title').text('TENDA '+product_name+' 路由器');
		//}
	login_status = pathname_arr[1];
	if (login_status ==0){
		$('#massage_text').text('您输入的用户名或密码错误，请重新输入。');
	}
	if(parent.window!=window) { 
		parent.window.location = window.location.toString();
	}
	document.forms[0].username.focus();
}
function initSize(){
	var pageSize = getPageSize(),
	pageWidth = pageSize.pageWidth -800 +1;
	$("#header_right").css("width",pageWidth);	
}
window.onresize = function(){
	//initSize();
}
function clearAll()
{
	document.forms[0].username.value="";
	document.forms[0].password.value="";	
}
function preSubmit()
{
	var f = document.forms[0];
	if(document.forms[0].username.value=="")
	{
		$('#massage_text').text('请您输入用户名。');
		document.forms[0].username.focus();
		return false;	
	}	
	if(document.forms[0].password.value=="")
	{
		$('#massage_text').text('请您输入密码。');
		document.forms[0].password.focus();
		return false;	
	}
	f.mitUSERNAME.value = f.username.value;
	f.mitPASSWORD.value = str_encode(f.password.value);
	f.username.disabled = true;
	f.password.disabled = true;
	document.forms[0].submit();
	
}
function keydown(evt)
{
	var keyCode = evt.keyCode ? evt.keyCode : evt.which ? evt.which : evt.charCode;
	if (keyCode==13) {
		preSubmit();
	}
}
</script>
