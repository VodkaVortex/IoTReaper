<script language="javascript">
var login_status = 0;
var sys_target = "<%getcfm("sys.targets");%>"; 
/*var GLOBAL = {};

GLOBAL.pageWidth = window.innerWidth;
GLOBAL.pageHeight = window.innerHeight;
if (typeof GLOBAL.pageWidth != 'number') {
